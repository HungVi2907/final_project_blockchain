{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Super Bells decision record v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "decision_id", "input_reference", "model_version", "model_artifact_sha256", "risk_probability", "shap_explanation", "timestamp_utc", "nonce"],
  "properties": {
    "schema_version": {"const": "1"},
    "dataset_id": {"enum": ["taiwan_uci350", "home_credit_2018"]},
    "decision_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_reference": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "model_artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "risk_probability": {"type": "string", "pattern": "^(?:0\\.[0-9]{8}|1\\.00000000)$"},
    "shap_explanation": {
      "type": "object", "additionalProperties": false,
      "required": ["method", "output_space", "base_value", "model_output", "feature_contributions"],
      "properties": {
        "method": {"type": "string", "minLength": 1, "maxLength": 128},
        "output_space": {"enum": ["raw", "probability"]},
        "base_value": {"$ref": "#/$defs/decimal8"},
        "model_output": {"$ref": "#/$defs/decimal8"},
        "feature_contributions": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["feature", "value"], "properties": {"feature": {"type": "string", "minLength": 1}, "value": {"$ref": "#/$defs/decimal8"}}}}
      }
    },
    "timestamp_utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "nonce": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
  },
  "$defs": {"decimal8": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)\\.[0-9]{8}$"}}
}

