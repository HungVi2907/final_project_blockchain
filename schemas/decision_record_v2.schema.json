    "input_reference": {"$ref": "decision_record_v1.schema.json#/properties/input_reference"},
    "model_version": {"$ref": "decision_record_v1.schema.json#/properties/model_version"},
    "model_artifact_sha256": {"$ref": "decision_record_v1.schema.json#/properties/model_artifact_sha256"},
    "risk_probability": {"$ref": "decision_record_v1.schema.json#/properties/risk_probability"},
    "shap_explanation": {"$ref": "decision_record_v1.schema.json#/properties/shap_explanation"},
    "timestamp_utc": {"$ref": "decision_record_v1.schema.json#/properties/timestamp_utc"},
    "nonce": {"$ref": "decision_record_v1.schema.json#/properties/nonce"}
  }
}
